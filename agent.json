{
  "version": "1.0",
  "logging": {
    "auto_configure": true,
    "pretty": true,
    "level": "INFO"
  },
  "events": {
    "type": "async",
    "config": {
      "max_history": 10000
    }
  },
  "runtime": {
    "type": "default",
    "config": {
      "tool_executor": {
        "type": "safe",
        "config": {
          "default_timeout_ms": 60000
        }
      }
    }
  }
}
