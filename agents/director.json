{
  "id": "director",
  "name": "Orchestrator Director",
  "extends": "_base.json",
  "prompts": [
    "prompts.roles.director:PRINCIPLES"
  ],
  "memory": {
    "type": "window_buffer",
    "config": {
      "window_size": 20
    }
  },
  "pattern": {
    "impl": "openagents_orchestration.patterns.director.DirectorPattern",
    "config": {
      "max_steps": 100,
      "max_tokens": 4096,
      "temperature": 0.6
    }
  },
  "llm": {
    "provider": "${LLM_PROVIDER:-openai_compatible}",
    "api_base": "${LLM_API_BASE}",
    "api_key_env": "${LLM_API_KEY_ENV:-LLM_API_KEY}",
    "model": "${LLM_MODEL}",
    "temperature": 0.6,
    "max_tokens": 4096,
    "timeout_ms": 180000
  },
  "tools": [
    "+classify_intent",
    "+decompose",
    "+spawn_agent",
    "+show_state",
    "+replan",
    "+finalize",
    "+ask_human",
    "+read_file",
    "+list_directory",
    "+bash",
    "+edit_file",
    "+apply_patch",
    "+todo_read",
    "+todo_write",
    "-send_message"
  ],
  "runtime": {
    "max_steps": 30,
    "step_timeout_ms": 600000,
    "session_queue_size": 1000,
    "event_queue_size": 4000
  }
}
