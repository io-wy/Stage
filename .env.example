# Copy to .env and fill in your provider details.

LLM_API_KEY=sk-
LLM_API_BASE=
LLM_MODEL=gpt-5.2

# Stage 服务治理意图识别。auto 表示检测到 LLM_API_* 可用时启用，否则降级。
STAGE_INTENT_LLM_ENABLED=auto
# 可选：单独覆盖治理意图识别模型配置；不填则复用 LLM_*。
# STAGE_INTENT_LLM_PROVIDER=openai_compatible
# STAGE_INTENT_LLM_API_BASE=
# STAGE_INTENT_LLM_API_KEY_ENV=LLM_API_KEY
# STAGE_INTENT_LLM_MODEL=
